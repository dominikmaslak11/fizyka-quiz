<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Fizyka dla inżynierów" android:textColor="@color/akcent"
            android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtPodsumowanie" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:textColor="@color/szary" android:textSize="13sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/tlo_karty"
            android:padding="14dp" android:layout_marginTop="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="MODUŁ" android:textColor="@color/szary" android:textSize="11sp" android:textStyle="bold" />
            <Spinner android:id="@+id/spModul" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="LICZBA PYTAŃ" android:textColor="@color/szary" android:layout_marginTop="10dp"
                android:textSize="11sp" android:textStyle="bold" />
            <Spinner android:id="@+id/spIle" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/txtPula" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textColor="@color/akcent" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>

        <Button android:id="@+id/btnNauka" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="TRYB NAUKI" android:textSize="15sp"
            android:background="@color/akcent" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btnEgzamin" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="EGZAMIN PRÓBNY" android:textSize="15sp"
            android:background="@color/akcent_jasny" android:textColor="#FFFFFF" />
        <Button android:id="@+id/btnBledy" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="POWTÓRKA BŁĘDÓW" android:textSize="15sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="POSTĘPY WEDŁUG MODUŁU"
            android:textColor="@color/szary" android:textSize="11sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/boxModuly" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="6dp" />

        <Button android:id="@+id/btnReset" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Wyczyść postępy" android:textSize="13sp"
            android:background="@android:color/transparent" android:textColor="@color/zle" />

        <TextView android:id="@+id/txtZrodlo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:textColor="@color/szary" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
